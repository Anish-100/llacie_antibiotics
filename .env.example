# API server (OpenAI-compatible) used by the *.api.<model> strategies
API_KEY=openai_compatible_api_key
BASE_URL=api_server
# Model requested from the API server; also names the API strategies. Defaults to openai/gpt-oss-120b
MODEL_NAME=
# reasoning_effort sent to the API server (low/medium/high). Use none for models whose server
# rejects the parameter, e.g. GLM-5.3-Flash. Defaults to high
REASONING_EFFORT=high

# CSV that failed notes/episodes are appended to (default logs/failed_notes.csv)
FAILURES_FILE=logs/failed_notes.csv
# Days before admission an antibiotic may have ended and still count as relevant (default 30)
RELEVANCE_DAYS=30

PG_HOST=postgres
PG_DBNAME=llacie
PG_USER=llacie
PG_PASS=llacie_password
PG_TABLE_PREFIX=llacie_
PG_EPISODE_TABLE=llacie_episodes
PG_COHORT_TABLE=llacie_cohorts

#########
# The following settings are specific to MGB's ERISTwo computing environment
# They can be safely ignored in other settings.
EDW_HOST='...'
EDW_USER='...'
# Overrides the system default odbcinst.ini which specifies available ODBC drivers.
# This is necessary on certain ERISTwo nodes, which haven't configured unixODBC
#    to know about FreeTDS drivers.
# Can either be a relative path from this module's directory, or an absolute path.
# Also see: https://manpages.ubuntu.com/manpages/jammy/man7/unixODBC.7.html
EDW_OVERRIDE_ODBCSYSINI=etc
#########